# Copy to .env.lanzou (git ignored), or use ~/.config/xgoatcast/lanzou.env.
# These credentials are only read by the release script, never by the website/client.
LANZOU_USERNAME=
LANZOU_PASSWORD=
# Optional: a browser login Cookie if the service requires interactive verification.
LANZOU_COOKIE=
# Optional: existing folder id; leave empty to publish directly in the root.
LANZOU_FOLDER_ID=
