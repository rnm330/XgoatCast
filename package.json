{
  "name": "xgoatcast",
  "version": "0.0.1-beta.1",
  "description": "Xgoat.Cast 屏幕共享 - 基于 Agora 与 KOOK 的屏幕共享机器人",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "release:all": "node scripts/release-all.cjs",
    "release:client": "node scripts/release-client.cjs",
    "test:release": "node --test scripts/test/*.test.cjs",
    "build:web": "npm run build --workspace web",
    "build:server": "npm run build --workspace server",
    "build": "npm run build:web && npm run build:server",
    "test": "npm run test --workspace server",
    "test:kook-isolation": "npm run test:kook-isolation --workspace server",
    "test:native-page": "node desktop/native-client/test-page/server.cjs",
    "start": "npm run start:prod --workspace server",
    "preview:panels": "node scripts/preview-panels.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1146.0"
  }
}
