# Private publish configuration; copy to .env.release (ignored) or ~/.config/xgoatcast/release.env.
CLIENT_RELEASE_PROVIDER=rainyun
S3_ENDPOINT=https://cn-nb2.rains3.com
S3_REGION=rainyun
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=downloads/windows/official
# Optional: public URL ending at the bucket, or a custom domain pointing to the bucket.
# Leave empty to use https://endpoint/bucket.
S3_PUBLIC_BASE_URL=
