# ===== xgoatcast 环境变量模板 =====
# 复制为 .env 并填写真实值

# 服务端口
PORT=3520

# 超级管理员密码（必填，未设置则服务拒绝启动）
SUPER_ADMIN_PASSWORD=

# CORS 允许的额外域名（可选，逗号分隔。不设则仅允许本地开发域名）
# ALLOWED_ORIGINS=https://custom-domain.com,https://other-domain.com

# KOOK HTTP API 请求超时（毫秒）
KOOK_API_TIMEOUT_MS=10000
# QQ robot (server-only credentials; Webhook transport)
QQ_APP_ID=
QQ_APP_SECRET=

# 自建共享面板的邮件发送（后台「邮件服务」可配置并优先于环境变量）
# 发信方式：smtp 或 tencent-ses（2026-03 后新开通的个人实名腾讯云 SES 账号不支持 SMTP，只能 API）
MAIL_PROVIDER=tencent-ses
# —— SMTP 分支 ——
SMTP_HOST=
SMTP_PORT=465
# 465 使用 true；587 使用 false（强制 STARTTLS）
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 发件人显示名称（选填，纯文本，如 Xgoat.Cast；后台「邮件服务」可配置并优先于此处）
MAIL_FROM_NAME=
# —— 腾讯云 SES 分支（接入步骤见 docs/SES_EMAIL_SETUP.md）——
SES_SECRET_ID=
SES_SECRET_KEY=
SES_FROM=
# 仅支持 ap-guangzhou / ap-hongkong
SES_REGION=ap-guangzhou
# 已审核通过的触发类邮件模板 ID（模板正文见 docs/ses-email-template.html）
SES_TEMPLATE_ID=
# 有反向代理时配置其可信 IP/CIDR，使注册限流按真实访客 IP 计算。
# 留空不信任转发头；不要使用任意来源 / 全网段。
TRUST_PROXY=
